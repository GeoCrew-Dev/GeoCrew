<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Projects live in /sdcard/GeoCrew, read and written by path (ADR 0002). -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- Points where the user stands (GNSS). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Photos for features, taken in the app (ADR 0011); a phone without a camera still installs it. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <!-- GPS tracks record in a foreground service of the location kind, with a notification
         that says so: the screen may be off, and no "allow all the time" is asked. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- While a track records: the CPU stays up for its points, and the user may let the app off battery optimization. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".GeoCrewApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.GeoCrew">
        <!-- Compose lays the screens out again when the phone turns; the map keeps
             its view, and the screens what they show, instead of starting over. -->
        <!-- One instance: a file sent from another app goes to the one running (onNewIntent). -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Files other apps open with GeoCrew or share to it: GIS data (GDAL's formats), and files of no
                 telling type, as .shp and .gpkg often come; they are copied into the GeoCrew folder's 导入. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/vnd.google-earth.kml+xml" />
                <data android:mimeType="application/vnd.google-earth.kmz" />
                <data android:mimeType="application/gpx+xml" />
                <data android:mimeType="application/geo+json" />
                <data android:mimeType="application/geopackage+sqlite3" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="image/tiff" />
                <data android:mimeType="image/vnd.dxf" />
                <data android:mimeType="application/dxf" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.google-earth.kml+xml" />
                <data android:mimeType="application/vnd.google-earth.kmz" />
                <data android:mimeType="application/gpx+xml" />
                <data android:mimeType="application/geo+json" />
                <data android:mimeType="application/geopackage+sqlite3" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="image/tiff" />
                <data android:mimeType="image/vnd.dxf" />
                <data android:mimeType="application/dxf" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>
        <service
            android:name=".TrackService"
            android:exported="false"
            android:foregroundServiceType="location" />
        <receiver
            android:name=".TrackActionReceiver"
            android:exported="false" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_files" />
        </provider>
    </application>
</manifest>
